<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <packaging>pom</packaging>

    <groupId>cc.uncarbon.framework</groupId>
    <artifactId>helium-starters-bom</artifactId>
    <version>${revision}</version>
    <name>${project.artifactId}</name>
    <description>
        统一管理框架内部依赖的版本号
    </description>

    <properties>
        <revision>4.0.0</revision>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>cc.uncarbon.framework</groupId>
                <artifactId>helium-core-base</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cc.uncarbon.framework</groupId>
                <artifactId>helium-core-bizlog</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cc.uncarbon.framework</groupId>
                <artifactId>helium-core-db</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cc.uncarbon.framework</groupId>
                <artifactId>helium-core-db-field-crypto</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cc.uncarbon.framework</groupId>
                <artifactId>helium-core-i18n</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cc.uncarbon.framework</groupId>
                <artifactId>helium-core-tenant</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cc.uncarbon.framework</groupId>
                <artifactId>helium-core-web</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cc.uncarbon.framework</groupId>
                <artifactId>helium-starter-base</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cc.uncarbon.framework</groupId>
                <artifactId>helium-starter-bizlog</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cc.uncarbon.framework</groupId>
                <artifactId>helium-starter-db-dynamic-datasource</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cc.uncarbon.framework</groupId>
                <artifactId>helium-starter-db-field-crypto</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cc.uncarbon.framework</groupId>
                <artifactId>helium-starter-db-mybatis-plus</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cc.uncarbon.framework</groupId>
                <artifactId>helium-starter-excel</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cc.uncarbon.framework</groupId>
                <artifactId>helium-starter-i18n</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cc.uncarbon.framework</groupId>
                <artifactId>helium-starter-jackson3</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cc.uncarbon.framework</groupId>
                <artifactId>helium-starter-openapi3</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cc.uncarbon.framework</groupId>
                <artifactId>helium-starter-ratelimiter-redis</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cc.uncarbon.framework</groupId>
                <artifactId>helium-starter-redis</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cc.uncarbon.framework</groupId>
                <artifactId>helium-starter-satoken</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cc.uncarbon.framework</groupId>
                <artifactId>helium-starter-tenant</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cc.uncarbon.framework</groupId>
                <artifactId>helium-starter-web</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cc.uncarbon.framework</groupId>
                <artifactId>helium-starter-web-security</artifactId>
                <version>${revision}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Maven Central 要求的元数据（本模块未继承 parent，需自行声明） -->
    <url>https://github.com/uncarbon-oss/helium-starters</url>

    <licenses>
        <license>
            <name>Apache 2</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
            <comments>A business-friendly OSS license</comments>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>Uncarbon</id>
            <name>Uncarbon</name>
        </developer>
    </developers>

    <scm>
        <tag>${project.version}</tag>
        <url>https://github.com/uncarbon-oss/helium-starters.git</url>
        <connection>scm:git:https://github.com/uncarbon-oss/helium-starters.git</connection>
        <developerConnection>scm:git:https://github.com/uncarbon-oss/helium-starters.git</developerConnection>
    </scm>

    <profiles>
        <profile>
            <id>push-helium-starters-to-maven-central</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <!-- Maven 编译插件 -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <version>3.16.0</version>
                        <configuration>
                            <source>${java.version}</source>
                            <target>${java.version}</target>
                        </configuration>
                    </plugin>

                    <!-- GPG 签名插件 -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- 部署插件 -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.12.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
