        统一管理 Helio 脚手架内部依赖的版本号
    </description>

    <properties>
        <revision>4.0.0-SNAPSHOT</revision>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>cc.uncarbon.framework</groupId>
                <artifactId>helio-core-base</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cc.uncarbon.framework</groupId>
                <artifactId>helio-starter-base</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cc.uncarbon.framework</groupId>
                <artifactId>helio-core-data</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cc.uncarbon.framework</groupId>
                <artifactId>helio-starter-data</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cc.uncarbon.framework</groupId>
                <artifactId>helio-core-tenant</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cc.uncarbon.framework</groupId>
                <artifactId>helio-starter-tenant</artifactId>
                <version>${revision}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
